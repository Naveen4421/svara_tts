# ============================================================================
# Svara TTS API - Environment Configuration
# ============================================================================
# Copy this file to .env and customize the values for your deployment

# ============================================================================
# vLLM Configuration
# ============================================================================

# Model repository ID from Hugging Face
# Default: kenpath/svara-tts-v1
VLLM_MODEL=kenpath/svara-tts-v1

# vLLM server host and port
VLLM_HOST=0.0.0.0
VLLM_PORT=8000

# GPU memory utilization (0.0-1.0)
# Lower values leave more memory for other processes
# Recommended: 0.85-0.95 for dedicated GPU
VLLM_GPU_MEMORY_UTILIZATION=0.9

# Maximum model context length
# Adjust based on your GPU memory
VLLM_MAX_MODEL_LEN=2048

# Number of GPUs to use for tensor parallelism
# Set to 1 for single GPU, increase for multi-GPU setups
VLLM_TENSOR_PARALLEL_SIZE=1

# Trust remote code from model repository
# Required for models with custom code
VLLM_TRUST_REMOTE_CODE=true

# Torch dtype for vLLM (auto, bfloat16, float16, float32)
VLLM_DTYPE=auto

# Let supervisord respawn crashed processes (true/false).
# Set false in test containers so a failure is visible instead of looping.
SUPERVISOR_AUTORESTART=true

# ============================================================================
# FastAPI Server Configuration
# ============================================================================

# FastAPI server host and port
API_HOST=0.0.0.0
API_PORT=8080

# vLLM base URL for API server to connect to
# Use http://localhost:8000/v1 for same-container deployment
VLLM_BASE_URL=http://localhost:8000/v1

# ============================================================================
# TTS Engine Configuration
# ============================================================================

# Device for SNAC decoder (cuda, mps, cpu, or auto)
TTS_DEVICE=cuda

# Restrict which voices this deployment will serve.
# Comma-separated voice IDs; unset/empty means all 38 v1 voices are available.
# Example: lock a deployment to Kannada only
#   ALLOWED_VOICES=kn_male,kn_female
ALLOWED_VOICES=

# Voice used by POST /tts when the request omits one.
# Defaults to the first entry of ALLOWED_VOICES when unset.
DEFAULT_VOICE=

# Longest text POST /tts accepts in one request (0 disables the check).
# A model limit, not a context limit: past ~400 characters the model stops
# following the text and emits speech-like audio in no real language, so this
# refuses the request instead of returning convincing nonsense with a 200.
# Use scripts/synthesize_long.py to read longer passages.
MAX_TTS_CHARS=400

# ============================================================================
# Hugging Face Configuration
# ============================================================================

# Hugging Face API token (optional)
# Required for gated models or private repositories
HF_TOKEN=

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
